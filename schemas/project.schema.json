{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cove-lang.org/schemas/project.schema.json",
  "title": "Cove project configuration",
  "type": "object",
  "required": [
    "project",
    "targets"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "default": "0.1.0"
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "defaultTarget": {
      "type": "string",
      "minLength": 1
    },
    "paths": {
      "type": "object",
      "properties": {
        "source": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [
            "src"
          ]
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [
            "src",
            "modules"
          ]
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [
            "include"
          ]
        },
        "build": {
          "type": "string",
          "default": "build"
        }
      },
      "additionalProperties": false
    },
    "compiler": {
      "type": "object",
      "properties": {
        "c": {
          "type": "string",
          "default": "auto"
        },
        "standard": {
          "type": "string",
          "default": "c11"
        },
        "optimization": {
          "enum": [
            "O0",
            "O1",
            "O2",
            "O3",
            "Os",
            "Oz"
          ],
          "default": "O0"
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "linkerFlags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "includeDirs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "libraryDirs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "libraries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_-]*$": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "executable",
                "object",
                "static",
                "shared"
              ]
            },
            "entry": {
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "cSources": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "output": {
              "type": "string",
              "default": "<target-name>"
            },
            "includeDirs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "libraryDirs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "libraries": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "entry"
              ]
            },
            {
              "required": [
                "sources"
              ]
            },
            {
              "required": [
                "cSources"
              ]
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
