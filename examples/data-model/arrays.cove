fun main() {
    let numbers: Array<Int> = [10, 20, 30];

    numbers.reserve(32);
    print(numbers.length);
    print(numbers.capacity);

    numbers.push(40);
    numbers[0] = 99;
    numbers[1] += 5;

    print(numbers[0]);
    print(numbers[1]);

    numbers.shrinkToFit();
    print(numbers.capacity);

    numbers.clear();
    print(numbers.length);
    print(numbers.capacity);
}
